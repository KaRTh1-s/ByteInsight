# =================================================================
# ByteInsight Frontend Environment Configuration Template
# Copy this file to .env or .env.local for local frontend development.
# IMPORTANT: In Create React App, variables starting with REACT_APP_
# are embedded into static JavaScript bundles at BUILD TIME.
# Any change to these variables requires rebuilding the app (npm run build).
# =================================================================

# Backend REST API Base URL
# Local development default:
REACT_APP_API_URL=http://localhost:8080/api

# Railway / Production example:
# REACT_APP_API_URL=https://your-backend-service.up.railway.app/api

# Backward compatibility alias
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Feature toggles
REACT_APP_ENABLE_IMAGE_ANALYSIS=true

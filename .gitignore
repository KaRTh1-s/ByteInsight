# =================================================================
# ByteInsight Root .gitignore
# Prevents credentials, build artifacts, and local environments from being tracked
# =================================================================

# OS Metadata
.DS_Store
Thumbs.db
Desktop.ini

# Environment Variables & Secrets (Keep .env.example templates only)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/.env.*
!**/.env.example

# Node / Frontend Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build/
dist/
**/build/
**/dist/

# Java / Maven Artifacts
target/
**/target/
*.jar
*.war
*.class

# JVM crashes and dumps
hs_err_pid*
replay_pid*

# IDE & Editor Configurations
.idea/
.vscode/
*.iml
*.sublime-workspace
.project
.classpath
.settings/

# Local logs and runtime databases
*.log
*.sqlite
*.db

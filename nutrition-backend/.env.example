# =================================================================
# ByteInsight Backend Environment Configuration Template
# Copy this file to .env or set these in Railway / production settings.
# PLACEHOLDERS ONLY - NEVER COMMIT REAL SECRETS OR PASSWORDS TO GIT.
# =================================================================

# Server Port (Railway automatically sets PORT at runtime; default is 8080)
PORT=8080

# Database Configuration (MySQL 8.0+)
# Local example:
DB_URL=jdbc:mysql://localhost:3306/nutritiondb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password

# Railway MySQL reference (configured via Railway Variables tab):
# DB_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?serverTimezone=UTC
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Database Schema & Hibernate Management
# Use 'update' for initial setup. Recommend 'validate' once schema is stabilized in production.
DDL_AUTO=update
SHOW_SQL=false

# JWT Authentication (REQUIRED)
# Must be a cryptographically secure string of at least 256 bits (32+ characters, recommend 64+).
# Generate on Linux/macOS/Git Bash: openssl rand -base64 64
JWT_SECRET=your_production_secure_random_jwt_secret_minimum_32_characters_long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
# Comma-separated list of trusted frontend origins.
# Local: http://localhost:3000,http://127.0.0.1:3000
# Railway/Production: https://your-frontend-domain.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Nutrition Data Providers
# The application uses a built-in verified database of 40+ foods if keys are omitted.
NUTRITION_API_KEY=your_optional_calorieninjas_api_key_here
CALORIENINJAS_API_KEY=your_optional_calorieninjas_api_key_here
USDA_API_KEY=your_optional_usda_api_key_here

# Optional AI / Computer Vision Provider
VISION_MODEL_ENABLED=false
OPENAI_API_KEY=your_optional_vision_api_key_here
